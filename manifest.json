{
  "manifest_version": 3,
  "name": "Relic",
  "version": "1.2.7",
  "minimum_chrome_version": "116",
  "description": "Turn SEC filings and investor documents into clear summaries, key takeaways, sentiment insights, and important changes.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "offscreen",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.sec.gov"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "host_permissions": [
    "https://*.sec.gov/*"
  ],
  "optional_host_permissions": [
    "https://*.annualreports.com/*",
    "https://*.stockanalysis.com/*",
    "https://*.fool.com/*",
    "https://*.benzinga.com/*",
    "https://*.sec.report/*",
    "https://finviz.com/*",
    "*://finance.yahoo.com/*",
    "*://*.macrotrends.net/*",
    "*://*.bamsec.com/*",
    "*://*.cnbc.com/*",
    "*://*.reuters.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sec.gov/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/settings/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Relic",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
