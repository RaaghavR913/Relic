{
  "name": "filing-lens",
  "version": "1.2.0",
  "private": true,
  "description": "On-Device SEC & Investor filing analysis - summaries, sentiment, redlines, YoY changes, and Q&A. 100% Private.",
  "type": "module",
  "scripts": {
    "fetch-models": "node scripts/fetch-models.mjs",
    "fetch-lm-dict": "node scripts/fetch-lm-dict.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "dev": "vite build --watch --mode development",
    "dev:ui": "vite --config vite.preview.config.ts",
    "build": "vite build && node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "framer-motion": "^12.40.0",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.1.43",
    "@types/dom-chromium-ai": "^0.0.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^3.2.6"
  }
}
